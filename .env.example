# Hextreco — local dev environment variables
# Copy this file to .env and adjust as needed. Never commit .env.

# ─── Backstage Postgres ──────────────────────────────────────────
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage
POSTGRES_DB=backstage
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Grafana ─────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Langfuse (self-hosted v2) ───────────────────────────────────
LANGFUSE_DB_USER=langfuse
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_DB_NAME=langfuse
LANGFUSE_NEXTAUTH_URL=http://localhost:3030
# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=replace-me-openssl-rand-base64-32
LANGFUSE_SALT=replace-me-openssl-rand-base64-32
# Generate with: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=replace-me-openssl-rand-hex-32
LANGFUSE_TELEMETRY_ENABLED=false

# ─── Backstage backend ───────────────────────────────────────────
# Used by app-config.local.yaml when present
BACKEND_SECRET=dev-only-change-me
